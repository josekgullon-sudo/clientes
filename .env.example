# Copia a .env y rellena. .env está en .gitignore.

# Contacto que aparece en el user-agent del bot, para que quien vea las visitas
# en sus logs sepa a quién escribir. Correo o URL.
AUDIT_CONTACTO=

# Ruta de la base de datos. Por defecto data/clientes.db
# DB_PATH=

# Directorio de capturas e informes. Por defecto out/
# DIR_SALIDAS=

# Rate limiting: espera mínima entre peticiones al mismo host, y tope de
# Crawl-delay que aceptamos antes de no auditar.
# RETARDO_MIN_MS=2000
# RETARDO_MAX_MS=30000

# Chromium alternativo (si no usas el que instala Playwright).
# CHROMIUM_PATH=

# Fase 1, pendientes de usar
# ANTHROPIC_API_KEY=
# PSI_API_KEY=
